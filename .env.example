# Copy this file to .env (keep this one as the template) and fill in what you need.
# Everything is optional: with nothing set, the system runs on sample data, rule-based.

# --- Intelligence layer (AI caption tagging + recommendations) ---
# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Instagram (Business or Creator account) ---
IG_ACCESS_TOKEN=
# Needed only for Facebook-style (EA...) / system-user tokens: the Instagram account ID from the Meta app dashboard
IG_USER_ID=
IG_API_VERSION=v23.0

# --- Analysis ---
# Analyse posting times in the account's local time zone (default UTC), e.g. Africa/Accra
ACCOUNT_TIMEZONE=
